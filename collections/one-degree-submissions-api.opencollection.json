{
  "opencollection": "1.0.0",
  "info": {
    "name": "One Degree Resource Server Housing Submissions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Submissions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List submissions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://data.1degree.org/v1/submissions",
            "params": [
              {
                "name": "page",
                "value": "3",
                "type": "query",
                "description": "The page offset. Default is 1."
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items to return. Default is 10."
              },
              {
                "name": "titles_only",
                "value": "true",
                "type": "query",
                "description": "Return only titles/basic info instead of full resource objects."
              }
            ]
          },
          "docs": "List submissions"
        }
      ]
    }
  ],
  "bundled": true
}